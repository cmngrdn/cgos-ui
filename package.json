{
  "name": "cgos-ui",
  "version": "0.4.0",
  "description": "Shared design tokens, atoms, and visual primitives for the Common Garden ecosystem (cgos dashboard + cmngrdn + feather + reliquary).",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./tokens.css": "./tokens.css",
    "./base.css": "./base.css",
    "./index.css": "./index.css",
    "./ui/Button": {
      "types": "./ui/Button.tsx",
      "import": "./ui/Button.tsx"
    },
    "./ui/Button.css": "./ui/Button.css",
    "./ui/IconButton": {
      "types": "./ui/IconButton.tsx",
      "import": "./ui/IconButton.tsx"
    },
    "./ui/IconButton.css": "./ui/IconButton.css",
    "./ui/Spinner": {
      "types": "./ui/Spinner.tsx",
      "import": "./ui/Spinner.tsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "tokens.css",
    "base.css",
    "index.css",
    "index.js",
    "index.d.ts",
    "ui/",
    "lib/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmngrdn/cgos-ui.git"
  },
  "sideEffects": [
    "*.css"
  ]
}
