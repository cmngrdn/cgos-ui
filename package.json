    },
    "./ui/IconButton.css": "./ui/IconButton.css",
    "./ui/Spinner": {
      "types": "./ui/Spinner.tsx",
      "import": "./ui/Spinner.tsx"
    },
    "./ui/Badge": {
      "types": "./ui/Badge.tsx",
      "import": "./ui/Badge.tsx"
    },
    "./ui/Toggle": {
      "types": "./ui/Toggle.tsx",
      "import": "./ui/Toggle.tsx"
    },
    "./ui/Toggle.css": "./ui/Toggle.css",
    "./ui/ProgressBar": {
      "types": "./ui/ProgressBar.tsx",
