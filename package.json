{
  "name": "cgos-ui",
  "version": "0.19.0",
  "description": "Shared design tokens, atoms, and visual primitives for the Common Garden ecosystem (cgos dashboard + cmngrdn + feather + reliquary).",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
